menu_rootpassword() {
    local _firstpass _secondpass _again _desc

    while true; do
        if [ -z "${_firstpass}" ]; then
            _desc="Enter the root password"
        else
            _again=" again"
        fi
        DIALOG --insecure --passwordbox "${_desc}${_again}" ${INPUTSIZE}
        if [ $? -eq 0 ]; then
            if [ -z "${_firstpass}" ]; then
                _firstpass="$(cat $ANSWER)"
            else
                _secondpass="$(cat $ANSWER)"
            fi
            if [ -n "${_firstpass}" -a -n "${_secondpass}" ]; then
                if [ "${_firstpass}" != "${_secondpass}" ]; then
                    INFOBOX "Passwords do not match! Please enter again." 6 60
                    unset _firstpass _secondpass _again
                    sleep 2 && clear && continue
                fi
                set_option ROOTPASSWORD "${_firstpass}"
                ROOTPASSWORD_DONE=1
                break
            fi
        else
            return
        fi
    done
}

set_rootpassword() {
    echo "root:$(get_option ROOTPASSWORD)" | chroot $TARGETDIR chpasswd -c SHA512
}

menu_useraccount() {
    local _firstpass _secondpass _desc _again
    local _groups _status _group _checklist
    local _preset _userlogin

    while true; do
        _preset=$(get_option USERLOGIN)
        [ -z "$_preset" ] && _preset="wig"
        DIALOG --inputbox "Enter a primary login name:" ${INPUTSIZE} "$_preset"
        if [ $? -eq 0 ]; then
            _userlogin="$(cat $ANSWER)"
            # based on useradd(8) § Caveats
            if [ "${#_userlogin}" -le 32 ] && [[ "${_userlogin}" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
                set_option USERLOGIN "${_userlogin}"
                USERLOGIN_DONE=1
                break
            else
                INFOBOX "Invalid login name! Please try again." 6 60
                unset _userlogin
                sleep 2 && clear && continue
            fi
        else
            return
        fi
    done

    while true; do
        _preset=$(get_option USERNAME)
        [ -z "$_preset" ] && _preset="WigNix User"
        DIALOG --inputbox "Enter a display name for login '$(get_option USERLOGIN)' :" \
            ${INPUTSIZE} "$_preset"
        if [ $? -eq 0 ]; then
            set_option USERNAME "$(cat $ANSWER)"
            USERNAME_DONE=1
            break
        else
            return
        fi
    done

    while true; do
        if [ -z "${_firstpass}" ]; then
            _desc="Enter the password for login '$(get_option USERLOGIN)'"
        else
            _again=" again"
        fi
        DIALOG --insecure --passwordbox "${_desc}${_again}" ${INPUTSIZE}
        if [ $? -eq 0 ]; then
            if [ -z "${_firstpass}" ]; then
                _firstpass="$(cat $ANSWER)"
            else
                _secondpass="$(cat $ANSWER)"
            fi
            if [ -n "${_firstpass}" -a -n "${_secondpass}" ]; then
                if [ "${_firstpass}" != "${_secondpass}" ]; then
                    INFOBOX "Passwords do not match! Please enter again." 6 60
                    unset _firstpass _secondpass _again
                    sleep 2 && clear && continue
                fi
                set_option USERPASSWORD "${_firstpass}"
                USERPASSWORD_DONE=1
                break
            fi
        else
            return
        fi
    done

    # Preselected: wheel for password sudo and wpa_supplicant control, storage for
    # mounting drives and shares through udisks2, input/network/plugdev for the
    # desktop, kvm and libvirt for virtual machines through virt-manager.
    _groups="wheel,audio,video,input,storage,network,plugdev,floppy,cdrom,optical,kvm,libvirt,users,xbuilder"
    while true; do
        _desc="Select group membership for login '$(get_option USERLOGIN)':"
        for _group in $(cat /etc/group); do
            _gid="$(echo ${_group} | cut -d: -f3)"
            _group="$(echo ${_group} | cut -d: -f1)"
            _status="$(echo ${_groups} | grep -w ${_group})"
            if [ -z "${_status}" ]; then
                _status=off
            else
                _status=on
            fi
            # ignore the groups of root, existing users, and package groups
            if [[ "${_gid}" -ge 1000 || "${_group}" = "_"* || "${_group}" =~ ^(root|nogroup|chrony|dbus|lightdm|polkitd)$ ]]; then
                continue
            fi
            if [ -z "${_checklist}" ]; then
                _checklist="${_group} ${_group}:${_gid} ${_status}"
            else
                _checklist="${_checklist} ${_group} ${_group}:${_gid} ${_status}"
            fi
        done
        DIALOG --no-tags --checklist "${_desc}" 20 60 18 ${_checklist}
        if [ $? -eq 0 ]; then
            set_option USERGROUPS $(cat $ANSWER | sed -e's| |,|g')
            USERGROUPS_DONE=1
            break
        else
            return
        fi
    done
}

# Seeds the AIDE database for the installed system, keeps a pristine copy in
# /boot and sets up the daily check whose report lands in the primary user's
# home (root's when no user account was created).
init_aide() {
    local _total

    [ -x $TARGETDIR/usr/bin/aide ] || return

    mkdir -p $TARGETDIR/etc/cron.daily
    cat > $TARGETDIR/etc/cron.daily/aide-report <<'EOF'
#!/bin/sh
# Daily AIDE check; the reports collect in root's ~/aide, readable by root only.
_dir=/root/aide
mkdir -p "$_dir"
chmod 700 "$_dir"
_out="$_dir/aide-report-$(date +%Y-%m-%d).txt"
rm -f "$_out"
set -C
aide --check > "$_out" 2>&1
chmod 600 "$_out"
EOF
    chmod 755 $TARGETDIR/etc/cron.daily/aide-report

    INFOBOX "Counting the files AIDE will record ..." 4 70
    _total=$(find $TARGETDIR/boot $TARGETDIR/etc $TARGETDIR/usr $TARGETDIR/opt \
        $TARGETDIR/var/log -xdev 2>/dev/null | wc -l)
    [ "$_total" -gt 0 ] || _total=1
    echo "Initialising the AIDE database ..." >$LOG
    # aide shows progress only on a terminal, so script lends it one; the file
    # count drives the gauge and everything else goes to the log.
    script -qefc "chroot $TARGETDIR aide --init" /dev/null 2>>$LOG |
        tr '\r' '\n' |
        awk -v total="$_total" -v logf="$LOG" '
            /^\[[0-9]+:[0-9]+\] / {
                if (/write db>/) { print 99; fflush(); next }
                if (match($0, /> [0-9]+ file/)) {
                    p = int(substr($0, RSTART + 2, RLENGTH - 7) * 100 / total)
                    print (p > 99 ? 99 : p); fflush()
                }
                next
            }
            NF { print >> logf }' |
        DIALOG --gauge "Initialising the AIDE integrity database ..." 7 70 0
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
        DIALOG --msgbox "${BOLD}${RED}ERROR:${RESET} \
AIDE could not build its database! check $LOG for errors." ${MSGBOXSIZE}
        return
    fi
    mv $TARGETDIR/var/lib/aide/aide.db.new $TARGETDIR/var/lib/aide/aide.db
    cp $TARGETDIR/var/lib/aide/aide.db $TARGETDIR/boot/aide.db.pristine
}

