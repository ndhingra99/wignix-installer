        if [ $? -eq 0 ]; then
            case "$(cat $ANSWER)" in
                American|Chinese) _keymap=us ;;
                British) _keymap=uk ;;
                German) _keymap=de ;;
                Japanese) _keymap=jp106 ;;
                Russian) _keymap=ru ;;
